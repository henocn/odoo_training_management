<odoo>
    <data>
    <!-- Vue liste -->
    <record id="view_training_session_list" model="ir.ui.view">
        <field name="name">training.session.list</field>
        <field name="model">training.session</field>
        <field name="arch" type="xml">
            <list string="Sessions de formation">
                <field name="name"/>
                <field name="course_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="seats"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire -->
    <record id="view_training_session_form" model="ir.ui.view">
        <field name="name">training.session.form</field>
        <field name="model">training.session</field>
        <field name="arch" type="xml">
            <form string="Session de formation">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="course_id"/>
                    </group>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="seats"/>
                    </group>
                </sheet>
            </form>
        </field>
        </record>
    </data>
</odoo>
