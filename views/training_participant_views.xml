<odoo>
    <data>
    <!-- Vue liste -->
    <record id="view_training_participant_list" model="ir.ui.view">
        <field name="name">training.participant.list</field>
        <field name="model">training.participant</field>
        <field name="arch" type="xml">
            <list string="Participants">
                <field name="name"/>
                <field name="email"/>
                <field name="contact"/>
                <field name="session_id"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire -->
    <record id="view_training_participant_form" model="ir.ui.view">
        <field name="name">training.participant.form</field>
        <field name="model">training.participant</field>
        <field name="arch" type="xml">
            <form string="Participant">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="email"/>
                        <field name="contact"/>
                        <field name="session_id"/>
                    </group>
                </sheet>
            </form>
        </field>
        </record>
    </data>
</odoo>
