<odoo>
    <data>
        <!-- Vue liste -->
        <record id="view_training_course_list" model="ir.ui.view">
            <field name="name">training.course.list</field>
            <field name="model">training.course</field>
            <field name="arch" type="xml">
                <list string="Formations">
                    <field name="name" />
                    <field name="duration" />
                    <field name="level" />
                </list>
            </field>
        </record>


        <!-- Vue formulaire -->
        <record id="view_training_course_form" model="ir.ui.view">
            <field name="name">training.course.form</field>
            <field name="model">training.course</field>
            <field name="arch" type="xml">
                <form string="Formation">
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="description" />
                            <field name="duration" />
                            <field name="level" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>